---
import { ENTITY, SITE } from '../config';

const AIRPORT_ROUTES = [
  {
    terminal: 'NAIA Terminal 1',
    detail: 'Mainly international flights (some Asian carriers)',
    steps: [
      'After clearing customs, queue at the official taxi counter on the arrivals level; decline drivers who approach you unsolicited',
      'Grab pickup is at a designated area on the arrivals level — follow the app directions',
      'The drive to Baywalk takes about 30–60 minutes; fare around ₱300–500',
    ],
  },
  {
    terminal: 'NAIA Terminal 2',
    detail: 'Mainly domestic flights',
    steps: [
      'Domestic baggage claim is quick — head straight to the ride-hailing pickup zone on the arrivals level',
      'Budget option: take a taxi to Taft Ave / EDSA and transfer to LRT-1, heading south to Pedro Gil',
      'For late-night arrivals, take a taxi directly; the last rail service ends around 21:30–22:00',
    ],
  },
  {
    terminal: 'NAIA Terminal 3',
    detail: 'Most international carriers; most complete facilities',
    steps: [
      'The arrivals level has official taxi, Grab and airport-bus counters — withdraw cash or exchange currency first',
      'The P2P airport express goes to EDSA Taft, then transfer to LRT-1 to Pedro Gil or Vito Cruz',
      'A direct taxi takes about 30–50 minutes off-peak; allow 60–90 minutes at peak',
    ],
  },
  {
    terminal: 'NAIA Terminal 4',
    detail: 'Low-cost carriers and some domestic routes',
    steps: [
      'The terminal is small — after exiting, walk to the roadside to hail a ride',
      'Walk or take a short taxi to Taft Ave to connect with LRT-1',
      'With lots of luggage, take a taxi directly to avoid multiple transfers',
    ],
  },
  {
    terminal: 'Clark International Airport (CRK)',
    detail: 'Northern alternative airport, about 90 km from Manila',
    steps: [
      'Airport buses run directly to Manila city (Cubao / Pasay terminals), about 2–3 hours',
      'After arrival, transfer to LRT-1 or a taxi to Baywalk',
      'If your flight arrives late, consider staying near the airport overnight before heading south',
    ],
  },
];

const PUBLIC_TRANSPORT = [
  {
    type: 'LRT-1 · Light Rail Line 1',
    items: [
      'Pedro Gil Station: exit and walk west along Pedro Gil St for 5–7 min to the mid-section of the promenade — the most recommended stop',
      'United Nations Ave Station: 10–12 min walk, good for combining with the National Museum and Rizal Park',
      'Vito Cruz Station: 15–20 min walk, good for the Cultural Center and the southern end',
      'Fare about ₱15–30, Beep card accepted; carriages are crowded 7–9 AM and 5–7 PM',
    ],
  },
  {
    type: 'PNR · Commuter Rail',
    items: [
      'Dela Rosa Station connects to Manila\'s southern commuter line; services are infrequent — check the timetable ahead',
      'Good for travellers from Laguna or Alabang; transferring to a jeepney or tricycle is faster',
      'Carriages are older and not air-conditioned — avoid the midday heat',
    ],
  },
  {
    type: 'EDSA Carousel · Bus Rapid Transit',
    items: [
      'A dedicated busway along EDSA with widely spaced, fast stops',
      'Transfer to LRT-1 southbound at Taft Ave Station to reach Baywalk',
      'Fare about ₱15–40, Beep card accepted',
    ],
  },
  {
    type: 'City bus & jeepney · City buses and jeepneys',
    items: [
      'City buses run along Taft Ave and Roxas Blvd, fare about ₱12–25',
      'Common jeepney route signs: "Malate – Pier South via Mabini", "Baclaran – Dapitan via Mabini"',
      'Tell the driver "Para po sa Roxas Blvd, Malate" to alight at the nearest junction',
      'First 4 km about ₱14, then about ₱2.20/km; cash or Beep card',
    ],
  },
  {
    type: 'Pasig River Ferry · Pasig River Ferry',
    items: [
      'Connects stations along the Pasig River — a nice complement to city sightseeing',
      'Schedules and stops change — check the latest operating information before you travel',
      'You still need a connection to Roxas Blvd from riverside stops; usually slower than rail',
    ],
  },
];

const TAXI = [
  'Pickup points: official taxi counters on the airport arrivals level, hotel entrances and designated mall bays — prefer app-based hailing',
  'Metering rule: flag-down about ₱45 (first 500 m), then about ₱4 per 300 m; insist on the meter',
  'Grab reference fares: NAIA T3 → Baywalk ₱300–500; Makati CBD ₱150–250; MOA / Pasay ₱120–180',
  'During peak hours (17:00–20:00) surcharges and wait times rise — book about 20 minutes early',
  'Tricycles / pedicabs suit the last ≤2 km; about ₱50–100 per ride — agree the price first',
];

const FROM_DISTRICTS = [
  { from: 'Makati CBD / BGC', how: 'Taxi 20–45 minutes (depending on EDSA and Osmeña Hwy congestion); or MRT-3 to Taft Ave then LRT-1', price: '₱150–300' },
  { from: 'Quezon City', how: 'MRT-3 south to Taft Ave then LRT-1, or LRT-2 to LRT-1; taxi 45–90 minutes', price: '₱200–400' },
  { from: 'Pasay / SM Mall of Asia', how: 'Head north along the waterfront via Roxas Blvd directly; taxi 15–30 minutes', price: '₱120–180' },
  { from: 'Parañaque / Las Piñas', how: 'North via Coastal Rd onto Roxas Blvd; buses and jeepneys also run along the route', price: '₱150–250' },
  { from: 'Alabang / Southern provinces', how: 'Skyway or the PNR commuter line north to Dela Rosa or EDSA Taft, then transfer', price: '₱200–350' },
  { from: 'Manila cruise / ferry terminal', how: 'After exiting North Harbor / South Harbor, taxi about 15–30 minutes; hail directly if you have lots of luggage', price: '₱150–250' },
];

const WALK_CYCLE = [
  'Walking: the promenade is about 2 km end to end; a full walk takes 25–35 minutes, with benches and shade along the way',
  'About 5–7 minutes from Pedro Gil Station; about 20–25 minutes from Rizal Park',
  'Cycling: Roxas Blvd has fast, dense traffic — only push or ride slowly on the promenade and its slow lanes',
  'After rain the pavement is slippery; keep your distance from unrailed sections of the seawall',
];

const PITFALLS = [
  'Decline "charter" drivers who approach you at arrivals; use official counters or app-based hailing',
  'Insist on the meter; if the driver refuses, switch cars or use a ride-hailing app',
  'For evening returns, choose well-lit, busy routes and proper pickup points; never take unmarked vehicles',
  'Cross at zebra crossings and footbridges — Roxas Blvd is fast; never jaywalk',
  'Keep valuables in an inside pocket; watch your phone and camera while taking photos',
];
---
<section id="transport-detail" class="anchor-offset py-16 sm:py-20 md:py-24">
  <div class="container-wide">
    <div class="max-w-3xl mb-10">
      <span class="chip bg-ocean-deep/10 text-ocean-deep mb-4">Transport playbook</span>
      <h2 class="section-title">Every way to reach {ENTITY.fullName}</h2>
      <p class="section-subtitle mb-0">
        Broken down by where you start: how to get from each airport terminal, how to transfer on public transport, how to hail taxis and ride-hailing, driving and parking, and how to reach the bay from neighbouring districts and the pier.
      </p>
    </div>

    <!-- AIRPORT -->
    <div class="card mb-8">
      <div class="p-6 sm:p-8 border-b border-sand-warm">
        <div class="font-display text-2xl font-semibold text-ocean-deep">From the airport</div>
        <p class="text-sm text-ocean-mid mt-1">Covered terminal by terminal, with drive time, fare ranges and transfer options.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-0 md:divide-x divide-sand-warm/80">
        {
          AIRPORT_ROUTES.map((a) => (
            <div class="p-6 border-b md:border-b-0 border-sand-warm/70">
              <div class="font-display text-lg font-semibold text-ocean-deep">{a.terminal}</div>
              <div class="text-xs text-ocean-mid mb-3">{a.detail}</div>
              <ol class="space-y-2">
                {a.steps.map((s, i) => (
                  <li class="flex gap-2.5 text-sm text-ocean-mid leading-relaxed">
                    <span class="shrink-0 w-5 h-5 rounded-full bg-sand-warm text-ocean-deep text-[11px] font-semibold flex items-center justify-center mt-0.5">
                      {i + 1}
                    </span>
                    <span>{s}</span>
                  </li>
                ))}
              </ol>
            </div>
          ))
        }
      </div>
      <div class="px-6 sm:px-8 py-5 border-t border-sand-warm">
        <a
          href={ENTITY.mapsShareUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-sunset-gradient text-white text-sm font-medium shadow-sm hover:-translate-y-0.5 transition"
        >
          Open {ENTITY.fullName} in Google Maps
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
        </a>
      </div>
    </div>

    <!-- PUBLIC TRANSPORT -->
    <div class="card p-6 sm:p-8 mb-8">
      <div class="font-display text-2xl font-semibold text-ocean-deep mb-1">By public transport</div>
      <p class="text-sm text-ocean-mid mb-6">Rail, bus rapid transit, city buses, jeepneys and the ferry — the cheapest ways to arrive, listed by system.</p>
      <div class="grid md:grid-cols-2 gap-6">
        {
          PUBLIC_TRANSPORT.map((p) => (
            <div class="rounded-2xl bg-sand-light p-5">
              <div class="font-display text-lg font-semibold text-ocean-deep mb-3">{p.type}</div>
              <ul class="space-y-2">
                {p.items.map((i) => (
                  <li class="flex gap-2 text-sm text-ocean-mid leading-relaxed">
                    <span class="text-sunset-orange mt-0.5">▸</span>
                    <span>{i}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="grid lg:grid-cols-3 gap-6 mb-8">
      <!-- TAXI -->
      <div class="card p-6 sm:p-7">
        <div class="font-display text-xl font-semibold text-ocean-deep mb-1">Taxi &amp; ride-hailing</div>
        <p class="text-xs text-ocean-mid mb-4">Pickup points, metering rules and reference fares.</p>
        <ul class="space-y-2.5">
          {
            TAXI.map((t) => (
              <li class="flex gap-2 text-sm text-ocean-mid leading-relaxed">
                <span class="text-sunset-orange mt-0.5">▸</span>
                <span>{t}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- FROM DISTRICTS -->
      <div class="card p-6 sm:p-7 lg:col-span-2">
        <div class="font-display text-xl font-semibold text-ocean-deep mb-1">From nearby districts</div>
        <p class="text-xs text-ocean-mid mb-4">Makati, BGC, Quezon City, Pasay, the southern provinces and the ferry terminal.</p>
        <div class="divide-y divide-sand-warm">
          {
            FROM_DISTRICTS.map((d) => (
              <div class="py-3 flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-4">
                <div class="font-medium text-ocean-deep text-sm sm:w-40 shrink-0">{d.from}</div>
                <div class="text-sm text-ocean-mid leading-relaxed flex-1">{d.how}</div>
                <div class="font-display font-semibold text-sunset-orange text-sm shrink-0">{d.price}</div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-6 mb-8">
      <!-- WALK & CYCLE -->
      <div class="card p-6 sm:p-7">
        <div class="font-display text-xl font-semibold text-ocean-deep mb-4">On foot &amp; by bike</div>
        <ul class="space-y-2.5">
          {
            WALK_CYCLE.map((w) => (
              <li class="flex gap-2 text-sm text-ocean-mid leading-relaxed">
                <span class="text-palm-green mt-0.5">▸</span>
                <span>{w}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-5 rounded-xl bg-sand-light p-4 text-sm text-ocean-mid leading-relaxed">
          Accessibility: ask to be dropped off at a set-down point on the
          <strong class="text-ocean-deep"> {SITE.address.street} </strong>
          side to shorten the walk; the promenade is generally flat with benches every 50–100 m, suitable for low-mobility and wheelchair users on short visits.
        </div>
      </div>

      <!-- PITFALLS -->
      <div class="card p-6 sm:p-7 border-sunset-pink/20">
        <div class="font-display text-xl font-semibold text-ocean-deep mb-4">Watch out for</div>
        <ul class="space-y-2.5">
          {
            PITFALLS.map((p) => (
              <li class="flex gap-2 text-sm text-ocean-mid leading-relaxed">
                <span class="text-sunset-pink mt-0.5">▸</span>
                <span>{p}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
