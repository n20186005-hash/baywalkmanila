---
import { CLUSTER_LABELS, getTopic, type TopicContent } from '../data/topics';
import { SITE, ENTITY } from '../config';

interface Props {
  topic: TopicContent;
}

const { topic } = Astro.props as Props;

const siteUrl: string | undefined = Astro.site?.toString() ?? ENTITY.domainUrl;
const homeUrl = new URL('/', siteUrl).toString();
const topicUrl = (slug: string) => new URL(`/${slug}/`, siteUrl).toString();

const relatedTopics = topic.related
  .map((slug) => getTopic(slug))
  .filter((t): t is TopicContent => Boolean(t));

const breadcrumbItems = [
  { name: 'Home', url: homeUrl },
  { name: topic.groupLabel, url: undefined },
  { name: topic.title, url: undefined },
];
---

<article class="bg-white">
  <div class="container-wide py-10 sm:py-14">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-ocean-mid">
      <ol class="flex flex-wrap items-center gap-1.5">
        {
          breadcrumbItems.map((b, i) => (
            <li class="flex items-center gap-1.5">
              {b.url ? (
                <a href={b.url} class="hover:text-sunset-orange transition">{b.name}</a>
              ) : (
                <span class={i === breadcrumbItems.length - 1 ? 'text-ocean-deep font-medium' : ''}>{b.name}</span>
              )}
              {i < breadcrumbItems.length - 1 && <span class="text-sand-warm">/</span>}
            </li>
          ))
        }
      </ol>
    </nav>

    <header class="max-w-3xl">
      <span class="chip bg-sunset-orange/10 text-sunset-orange mb-4">{topic.groupLabel}</span>
      <h1 class="font-display text-3xl sm:text-4xl font-semibold text-ocean-deep leading-tight">
        {topic.title}
      </h1>
      <p class="text-ocean-mid leading-relaxed mt-4">{topic.intro}</p>
    </header>

    <!-- Sections -->
    <div class="mt-10 space-y-10 max-w-3xl">
      {
        topic.sections.map((s) => (
          <section id={s.id} class="anchor-offset">
            <h2 class="font-display text-xl sm:text-2xl font-semibold text-ocean-deep mb-3">
              {s.heading}
            </h2>
            <div class="space-y-3 text-ocean-mid leading-relaxed">
              {s.body.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <!-- FAQ -->
    <section id="faq" class="anchor-offset mt-12 max-w-3xl">
      <h2 class="font-display text-xl sm:text-2xl font-semibold text-ocean-deep mb-5">
        Frequently asked questions
      </h2>
      <div class="divide-y divide-sand-warm border-y border-sand-warm">
        {
          topic.faq.map((f) => (
            <details class="py-4 group">
              <summary class="flex items-center justify-between cursor-pointer text-ocean-deep font-medium list-none">
                <span>{f.q}</span>
                <span class="text-sunset-orange text-xl group-open:rotate-45 transition-transform">+</span>
              </summary>
              <p class="mt-3 text-ocean-mid leading-relaxed">{f.a}</p>
            </details>
          ))
        }
      </div>
      <p class="mt-4 text-xs text-ocean-mid/80 leading-relaxed">
        Times, fees and access rules may change. This is an independent, non-official guide — please verify on site and respect official signage when visiting.
      </p>
    </section>

    <!-- Related -->
    {
      relatedTopics.length > 0 && (
        <section class="anchor-offset mt-12 max-w-4xl">
          <h2 class="font-display text-xl sm:text-2xl font-semibold text-ocean-deep mb-5">
            Related guides
          </h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {relatedTopics.map((r) => (
              <a
                href={topicUrl(r.slug)}
                class="card p-5 hover:border-sunset-orange transition block"
              >
                <div class="text-[11px] uppercase tracking-wider text-ocean-mid mb-2">
                  {CLUSTER_LABELS[r.cluster]}
                </div>
                <div class="font-medium text-ocean-deep leading-snug">{r.title}</div>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</article>
