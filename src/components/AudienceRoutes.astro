---
import { ENTITY } from '../config';

const ROUTES = [
  {
    tag: 'Families',
    duration: '1.5 – 2.5 h',
    pace: 'Rest in the shade every 30 minutes',
    steps: [
      'Enter from the north-end gate and acclimate in the tree-shaded corridor',
      'Dolomite Beach mid-section: sand play, kite flying, shallows observation (no swimming)',
      'Top up snacks and drinks at the boardwalk stalls and use the nearest restroom',
      'Claim a sunset viewing spot 40 min early; leave within 15 min after sunset to avoid crowds',
    ],
    notes: [
      'Bring your own child sun hat, sunscreen and drinking water; ground is hottest at midday, avoid 11 – 15 h',
      'Dolomite Beach closes for maintenance on Thursdays — plan family trips around it',
      'Weekends 17:00 – 19:00 are the busiest; strollers move slowly, prefer weekdays or arrive early',
    ],
    tone: 'bg-sunset-orange/10 text-sunset-orange',
  },
  {
    tag: 'Photography & nature',
    duration: '2.5 – 4 h',
    pace: 'Slow, set up at a spot and stay 20 – 40 min',
    steps: [
      'Arrive 16:30, meter and pick a foreground along the corridor and seawall',
      'Observe the intertidal flat (check the day\'s tide table; low tide reveals more life)',
      '17:45 – 18:15 sunset prime: sun, crepuscular rays, silhouetted boats',
      '20 min after sunset blue hour: balance of city lights and sky',
    ],
    notes: [
      'Set up tripods on the outer edge of the corridor to keep the path clear; watch gear at night',
      'Bird season (Nov – Mar) favors 300 mm+ telephoto; the southern wetland is the main spot',
      'Respect reserve boundaries and warning lines; no flash on birds; no entry to closed rehab zones',
    ],
    tone: 'bg-ocean-mid/10 text-ocean-mid',
  },
  {
    tag: 'Low intensity / accessibility',
    duration: '1 – 1.5 h',
    pace: 'Short moves, rest every 50 – 100 m at a seat',
    steps: [
      'Drop off directly at the Roxas Blvd side to cut walking distance',
      'Stroll slowly one-way on the level corridor; prefer railed, backed seating',
      'Pick an open-view seat for the sunset',
      'Return the same way to the drop-off; avoid dark stretches at night',
    ],
    notes: [
      'The corridor is mostly flat but watch seams and ramps; enter from the Roxas Blvd side for wheelchairs',
      'Most reliable accessible restrooms are in the malls and hotel lobbies along the route',
      'Avoid midday and post-rain slippery surfaces; carry regular medication and an ID card',
    ],
    tone: 'bg-palm-green/10 text-palm-green',
  },
];
---
<section id="audience-routes" class="anchor-offset py-16 sm:py-20 md:py-24 bg-white border-y border-sand-warm">
  <div class="container-wide">
    <div class="max-w-3xl mb-10">
      <span class="chip bg-sunset-purple/10 text-sunset-purple mb-4">Routes by traveller type</span>
      <h2 class="section-title">Three ways to spend your time at {ENTITY.shortName}</h2>
      <p class="section-subtitle mb-0">
        Choose by who is travelling and the pace: families, photography &amp; nature watching, or low-intensity and accessible. Each route lists its duration, flow and key notes.
      </p>
    </div>

    <div class="grid lg:grid-cols-3 gap-6">
      {
        ROUTES.map((r, i) => (
          <article class="card p-6 flex flex-col">
            <div class="flex items-center justify-between mb-4">
              <span class={`chip ${r.tone}`}>{r.tag}</span>
              <span class="text-xs text-ocean-mid font-medium">Route {i + 1}</span>
            </div>

            <div class="grid grid-cols-2 gap-3 mb-5">
              <div class="rounded-xl bg-sand-light p-3">
                <div class="text-[11px] uppercase tracking-wider text-ocean-mid">Duration</div>
                <div class="font-display font-semibold text-ocean-deep">{r.duration}</div>
              </div>
              <div class="rounded-xl bg-sand-light p-3">
                <div class="text-[11px] uppercase tracking-wider text-ocean-mid">Pace</div>
                <div class="text-sm text-ocean-deep font-medium leading-snug">{r.pace}</div>
              </div>
            </div>

            <div class="font-semibold text-ocean-deep text-sm mb-2">Suggested flow</div>
            <ol class="space-y-2.5 mb-5">
              {r.steps.map((s, j) => (
                <li class="flex gap-2.5 text-sm text-ocean-mid leading-relaxed">
                  <span class="shrink-0 w-5 h-5 rounded-full bg-sand-warm text-ocean-deep text-[11px] font-semibold flex items-center justify-center mt-0.5">
                    {j + 1}
                  </span>
                  <span>{s}</span>
                </li>
              ))}
            </ol>

            <div class="font-semibold text-ocean-deep text-sm mb-2">Key notes</div>
            <ul class="space-y-2 text-sm text-ocean-mid leading-relaxed flex-1">
              {r.notes.map((n) => (
                <li class="flex gap-2">
                  <span class="text-sunset-orange mt-0.5">▸</span>
                  <span>{n}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
