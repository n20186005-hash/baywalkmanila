---
interface Props {
  rating: number;
  size?: number;
  class?: string;
}

const { rating = 5, size = 16 } = Astro.props;
const filled = Math.round(rating);
---
<span class:list={['inline-flex items-center gap-0.5 shrink-0', Astro.props.class]} aria-label={`${rating} out of 5 stars`} role="img">
  {
    Array.from({ length: 5 }).map((_, i) => (
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width={size}
        height={size}
        viewBox="0 0 24 24"
        fill={i < filled ? 'currentColor' : 'none'}
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class={i < filled ? 'text-sunset-orange' : 'text-sand-warm'}
      >
        <path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
      </svg>
    ))
  }
</span>
