---
import { ENTITY } from '../config';

const SERVICES = [
  {
    title: 'Restrooms & baby care · 卫生间与母婴',
    points: [
      '长廊沿线设有公共卫生间，多为付费使用（约 ₱5 – 10），建议自备零钱、纸巾与免洗洗手液',
      '沿线商场、快餐店与酒店大堂的卫生间维护状况通常更好，且多数免费',
      '母婴台与独立哺乳空间在长廊沿线较少，建议安排在商场或酒店解决',
    ],
  },
  {
    title: 'Drinking water & supplies · 饮水与补给',
    points: [
      '公共直饮水点数量有限，建议自带可重复使用的水杯（沙滩段限制一次性塑料）',
      '饮用水、运动饮料与电解质补充可在便利店与快餐店购买',
      '高温时段每小时补水一次；白色沙滩反射强烈，注意头部防晒',
    ],
  },
  {
    title: 'Food & drink types · 餐饮类型',
    points: [
      '路边小吃摊：鱼丸、炸物、烤串、炸香蕉与冰饮，单价最低、出餐最快',
      '连锁快餐与家庭式餐厅：空调环境、适合家庭与长者，价格中等',
      '海鲜与湾区景观餐厅：以海景与套餐为主，价格较高，日落时段需等位',
      '咖啡馆、烘焙与甜品店、便利店便当：适合补给与短时休息',
      '本站为独立非盈利科普站点：仅按餐饮类型做中立概述，不推荐任何具体商户',
    ],
  },
  {
    title: 'Accommodation types · 住宿类型',
    points: [
      '经济型旅馆与胶囊/青旅：预算优先，多集中在 Malate、Ermita 老城街巷',
      '商务酒店与服务式公寓：设施完整，集中在 Pasay 湾区与 Makati 商务区',
      '民宿与长住公寓：适合家庭与长住，需确认电梯、停车与门禁',
      '选址思路：优先看通勤时间与夜间照明，而非单纯距离；老城近景点，湾区近机场与大型商场',
    ],
  },
  {
    title: 'Groceries & daily needs · 商超与日常采购',
    points: [
      '24 小时便利店：饮料、简餐、雨具、常用药与充值，密度高',
      '社区杂货店（sari-sari store）：小份零食与日用品，价格便宜、多为现金',
      '中型超市与商场大卖场：一次性补齐防晒、拖鞋、纪念品与伴手礼',
      '连锁药房：常驻药师，可买防晒、止泻与防蚊用品；银行 ATM 与货币兑换点集中在主干道与商场',
    ],
  },
  {
    title: 'Fuel & EV charging · 加油与充电',
    points: [
      '市区加油站以全服务为主（工作人员加油），多数接受现金，部分支持刷卡',
      'EV 充电桩主要设置在商场、酒店与部分加油站，通常需 App 或会员卡启用',
      '加油站便利店常配套 ATM、卫生间与简餐，适合自驾中途补给',
      '自驾进湾区请避开 17:00 – 19:30 的 Roxas Blvd 拥堵时段',
    ],
  },
  {
    title: 'Parking · 停车',
    points: [
      '路边泊位：有人看管，按小时计费，日落时段与周末一位难求',
      '商场与酒店停车场：有顶棚、监控与无障碍车位，安全性更高',
      '摩托车位收费更低，但需自备锁具并带走头盔与贵重物品',
      '切勿在车内留置可见物品；取车前确认是否需凭停车卡缴费',
    ],
  },
  {
    title: 'Medical & safety · 医疗与安全',
    points: [
      '连锁药房可处理轻度中暑、擦伤与肠胃不适；社区诊所可做简单处理',
      '综合医院急诊在 Malate 与 Manila 市区均有，重症请直接前往或拨打急救电话 911',
      '长廊设有安保岗亭与巡逻人员，开放时段沙滩区有救生员值守',
      '建议保存住宿地址与紧急联系人卡片，避免夜间单独前往照明不足路段',
    ],
  },
  {
    title: 'Accessibility · 无障碍',
    points: [
      '长廊整体平坦，适合轮椅与推车通行；个别接缝、坡道与树池需留意',
      '靠背座椅间隔约 50 – 100 m，海堤段视野开阔但遮荫较少',
      '无障碍卫生间最可靠的选择是沿线商场与酒店大堂',
      '建议从 Roxas Blvd 一侧进入，减少绕行；雨后路面湿滑需减速',
    ],
  },
  {
    title: 'Connectivity & extras · 通信与其他',
    points: [
      '公共网络覆盖有限，商场与咖啡馆的网络更稳定；移动数据信号整体良好',
      '遮荫避雨点：凉亭、天桥与商场连廊，雷阵雨时可临时躲避 20 – 30 分钟',
      '行李寄存：酒店礼宾或商场储物柜更适合；长廊不建议携带大件行李',
      '宠物需牵绳并避让人流高峰；部分时段与区域可能限制入内，以现场公告为准',
    ],
  },
];
---
<section id="visitor-services" class="anchor-offset py-16 sm:py-20 md:py-24 bg-white border-y border-sand-warm">
  <div class="container-wide">
    <div class="max-w-3xl mb-10">
      <span class="chip bg-ocean-mid/10 text-ocean-mid mb-4">Visitor services · 访客服务与周边设施</span>
      <h2 class="section-title">Visitor services &amp; facilities around {ENTITY.fullName}</h2>
      <p class="section-subtitle mb-0">
        卫生间、停车、餐饮、住宿、商超、加油充电、医疗与无障碍：按设施类型做中立概述，帮助你在到达前把补给、休息与返程安排清楚。
      </p>
    </div>

    <div class="rounded-2xl bg-sand-light border border-sand-warm p-5 mb-8 text-sm text-ocean-mid leading-relaxed">
      本站为独立非盈利科普站点，以下内容仅按<strong class="text-ocean-deep">设施类型</strong>做中立概述，不做任何商户推荐、排名或商业合作。涉及价格与开放时间的数字为常见区间，实际请以现场公告为准。
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        SERVICES.map((s) => (
          <article class="card p-6 flex flex-col">
            <h3 class="font-display text-lg font-semibold text-ocean-deep mb-3">{s.title}</h3>
            <ul class="space-y-2 text-sm text-ocean-mid leading-relaxed flex-1">
              {s.points.map((p) => (
                <li class="flex gap-2">
                  <span class="text-sunset-orange mt-0.5">▸</span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
