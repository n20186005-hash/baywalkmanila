---
import { ENTITY } from '../config';

const SERVICES = [
  {
    title: 'Restrooms & baby care',
    points: [
      'Public restrooms along the promenade are mostly paid (about ₱5–10); bring small change, tissue and hand sanitiser',
      'Restrooms in malls, fast-food outlets and hotel lobbies are usually better maintained and mostly free',
      'Changing tables and private nursing spaces are scarce along the promenade — use a mall or hotel instead',
    ],
  },
  {
    title: 'Drinking water & supplies',
    points: [
      'Public drinking fountains are limited; bring a reusable bottle (single-use plastics are restricted on the beach)',
      'Buy drinking water, sports drinks and electrolytes at convenience stores and fast-food outlets',
      'Drink water hourly in the heat; the white sand reflects strongly, so protect your head from the sun',
    ],
  },
  {
    title: 'Food & drink types',
    points: [
      'Roadside stalls: fish balls, fried snacks, skewers, banana fritters and cold drinks — cheapest and fastest',
      'Chain fast food and family restaurants: air-conditioned, good for families and seniors, mid-range',
      'Seafood and bay-view restaurants: sea views and set menus, pricier, with waits at sunset',
      'Cafés, bakeries, dessert shops and convenience-store meals: good for supplies and a short break',
      'This is an independent, non-commercial guide: we only give a neutral overview by food type and recommend no specific business',
    ],
  },
  {
    title: 'Accommodation types',
    points: [
      'Budget inns, capsule hotels and hostels: value first, mostly in the old streets of Malate and Ermita',
      'Business hotels and serviced apartments: full facilities, in Pasay bay area and the Makati business district',
      'Guesthouses and long-stay apartments: good for families and longer stays; check lifts, parking and access control',
      'Choosing where to stay: prioritise commute time and night-time lighting over raw distance; the old town is near the sights, the bay area near the airport and big malls',
    ],
  },
  {
    title: 'Groceries & daily needs',
    points: [
      '24-hour convenience stores: drinks, light meals, rain gear, basic medicine and top-ups, high density',
      'Neighbourhood sari-sari stores: small snacks and daily goods, cheap, mostly cash',
      'Mid-size supermarkets and mall stores: stock up on sunscreen, flip-flops, souvenirs and gifts in one trip',
      'Chain pharmacies: a resident pharmacist can supply sunscreen, anti-diarrhoea and mosquito repellent; bank ATMs and money changers cluster on main roads and in malls',
    ],
  },
  {
    title: 'Fuel & EV charging',
    points: [
      'City petrol stations are mostly full-service (attendants pump the fuel), mostly cash, some accept cards',
      'EV chargers are mainly at malls, hotels and some stations, usually activated via an app or membership card',
      'Station convenience stores often have ATMs, restrooms and snacks — handy for a self-drive top-up',
      'Avoid Roxas Blvd congestion 17:00–19:30 when driving into the bay area',
    ],
  },
  {
    title: 'Parking',
    points: [
      'Roadside bays: attended, charged hourly, hard to find at sunset and on weekends',
      'Mall and hotel car parks: shaded, monitored and with accessible bays, safer',
      'Motorcycle bays are cheaper but bring your own lock and take helmets and valuables with you',
      'Never leave visible items in the car; check whether you must pay at a machine before leaving',
    ],
  },
  {
    title: 'Medical & safety',
    points: [
      'Chain pharmacies handle mild heatstroke, scrapes and stomach upset; community clinics do basic care',
      'Hospital emergency departments are in Malate and central Manila; for serious cases go directly or dial 911',
      'The promenade has security kiosks and patrols; lifeguards are on duty on the beach during opening hours',
      'Keep your accommodation address and an emergency-contact card; avoid dimly lit stretches alone at night',
    ],
  },
  {
    title: 'Accessibility',
    points: [
      'The promenade is mostly flat and good for wheelchairs and strollers; watch a few joints, ramps and tree pits',
      'Backed benches every 50–100 m; the seawall section has open views but less shade',
      'The most reliable accessible toilets are in the malls and hotel lobbies along the route',
      'Enter from the Roxas Blvd side to cut detours; slow down on slippery pavements after rain',
    ],
  },
  {
    title: 'Connectivity & extras',
    points: [
      'Public Wi-Fi is limited; mall and café networks are more stable; mobile data signal is generally good',
      'Shade and rain shelter: gazebos, footbridges and mall walkways — duck in for 20–30 min during a thunderstorm',
      'Luggage storage: hotel concierge or mall lockers are best; avoid bringing large luggage onto the promenade',
      'Keep pets leashed and avoid peak crowds; some times/areas may restrict pets — follow on-site notices',
    ],
  },
];
---
<section id="visitor-services" class="anchor-offset py-16 sm:py-20 md:py-24 bg-white border-y border-sand-warm">
  <div class="container-wide">
    <div class="max-w-3xl mb-10">
      <span class="chip bg-ocean-mid/10 text-ocean-mid mb-4">Visitor services</span>
      <h2 class="section-title">Visitor services &amp; facilities around {ENTITY.fullName}</h2>
      <p class="section-subtitle mb-0">
        Restrooms, parking, food and drink, accommodation, groceries, fuel and charging, medical care and accessibility: a neutral overview by facility type, so you can sort out supplies, rest and your return trip before you arrive.
      </p>
    </div>

    <div class="rounded-2xl bg-sand-light border border-sand-warm p-5 mb-8 text-sm text-ocean-mid leading-relaxed">
      This is an independent, non-commercial guide. The following is a neutral overview by <strong class="text-ocean-deep">facility type</strong> only — no business recommendations, rankings or commercial ties. Figures for price and opening hours are typical ranges; follow on-site notices for the actual values.
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        SERVICES.map((s) => (
          <article class="card p-6 flex flex-col">
            <h3 class="font-display text-lg font-semibold text-ocean-deep mb-3">{s.title}</h3>
            <ul class="space-y-2 text-sm text-ocean-mid leading-relaxed flex-1">
              {s.points.map((p) => (
                <li class="flex gap-2">
                  <span class="text-sunset-orange mt-0.5">▸</span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
