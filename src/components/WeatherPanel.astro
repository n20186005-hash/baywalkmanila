---
import {
  describeWeatherCode,
  rainChance,
  umbrellaAdvice,
  sunAdvice,
  uvLabel,
  humidityLabel,
  beaufort,
  buildAdvice,
  type WeatherSnapshot,
} from '../lib/weather';
import { seaAdvice } from '../lib/tide';
import { ENTITY } from '../config';

interface Props {
  weather: WeatherSnapshot | null;
  sea: { waveHeight: number | null; seaTemp: number | null } | null;
}

const { weather, sea } = Astro.props;

const TZ = 'Asia/Manila';
const dayFmt = new Intl.DateTimeFormat('en-PH', {
  timeZone: TZ,
  weekday: 'short',
  month: 'short',
  day: 'numeric',
});
const timeFmt = new Intl.DateTimeFormat('en-PH', {
  timeZone: TZ,
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
});

function toDate(dateStr: string): Date {
  return new Date(`${dateStr.length === 10 ? dateStr : dateStr.slice(0, 10)}T00:00:00+08:00`);
}

function hhmm(iso: string): string {
  if (!iso) return '—';
  const d = new Date(iso.length === 16 ? `${iso}:00+08:00` : iso);
  return Number.isNaN(d.getTime()) ? iso.slice(11, 16) : timeFmt.format(d);
}

const today = weather?.daily[0] ?? null;
const current = weather?.current ?? null;
const condition = current ? describeWeatherCode(current.weatherCode) : null;
const advice = today ? umbrellaAdvice(today) : null;
const bundle = weather ? buildAdvice(weather) : null;
const wind = current ? beaufort(Math.max(current.windSpeed, today?.windSpeedMax ?? 0)) : null;
const seaLine = sea ? seaAdvice(sea) : null;

const adviceTone: Record<string, string> = {
  needed: 'bg-ocean-deep/10 text-ocean-deep border-ocean-deep/20',
  possible: 'bg-sunset-orange/10 text-sunset-orange border-sunset-orange/20',
  none: 'bg-palm-green/10 text-palm-green border-palm-green/20',
};

const BLOCKS = [
  { key: 'outfit', title: 'Outfit', icon: 'shirt' },
  { key: 'plan', title: 'Plan', icon: 'route' },
  { key: 'packing', title: 'Packing', icon: 'bag' },
] as const;
---
<section id="weather" class="anchor-offset py-16 sm:py-20 md:py-24 bg-white border-y border-sand-warm">
  <div class="container-wide">
    <div class="max-w-3xl mb-10">
      <span class="chip bg-ocean-mid/10 text-ocean-mid mb-4">Live Weather</span>
      <h2 class="section-title">Weather at {ENTITY.fullName} — what to do about it</h2>
      <p class="section-subtitle mb-0">
        Not just the temperature: below we tell you what to wear today, how to plan, what to pack, and any risk worth noting. Data updates in the Asia/Manila time zone (GMT+8).
      </p>
    </div>

    {
      weather && current && today && condition && advice && bundle && wind ? (
        <>
          <div class="grid lg:grid-cols-5 gap-6">
            <!-- BASE WEATHER -->
            <div class="lg:col-span-2 card p-6 sm:p-7">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <div class="text-xs uppercase tracking-wider text-ocean-mid">Now</div>
                  <div class="flex items-end gap-2 mt-1">
                    <span class="font-display text-5xl sm:text-6xl font-semibold text-ocean-deep leading-none">
                      {Math.round(current.temperature)}
                    </span>
                    <span class="text-xl text-ocean-mid pb-1">°C</span>
                  </div>
                  <div class="text-sm text-ocean-mid mt-2">
                    Feels like {Math.round(current.apparentTemperature)}°C
                  </div>
                </div>
                <div class="text-right">
                  <div class="font-display text-lg font-semibold text-ocean-deep">{condition.label}</div>
                  <div class="text-xs text-ocean-mid mt-1">
                    {current.isDay ? 'Day' : 'Night'} · {Math.round(today.tempMin)}–{Math.round(today.tempMax)}°C
                  </div>
                </div>
              </div>

              <div class="mt-5 flex flex-wrap gap-2">
                <span class="chip bg-ocean-mid/10 text-ocean-mid">
                  Rain chance {rainChance(today)}%
                </span>
                <span class="chip bg-sand-warm text-ocean-deep">
                  Wind {wind.level} · {wind.name}
                </span>
                <span class="chip bg-sand-warm text-ocean-deep">
                  Humidity {current.humidity}% · {humidityLabel(current.humidity)}
                </span>
              </div>

              <div class="mt-5 grid grid-cols-3 gap-3 text-sm">
                <div class="rounded-xl bg-sand-light p-3">
                  <div class="text-[11px] uppercase tracking-wider text-ocean-mid">Sunrise</div>
                  <div class="font-display font-semibold text-ocean-deep text-lg">{hhmm(today.sunrise)}</div>
                </div>
                <div class="rounded-xl bg-sand-light p-3">
                  <div class="text-[11px] uppercase tracking-wider text-ocean-mid">Sunset</div>
                  <div class="font-display font-semibold text-ocean-deep text-lg">{hhmm(today.sunset)}</div>
                </div>
                <div class="rounded-xl bg-sand-light p-3">
                  <div class="text-[11px] uppercase tracking-wider text-ocean-mid">Peak UV today</div>
                  <div class="font-display font-semibold text-ocean-deep text-lg">
                    {today.uvIndexMax !== null ? `${Math.round(today.uvIndexMax)}` : '—'}
                  </div>
                  <div class="text-[11px] text-ocean-mid">{uvLabel(today.uvIndexMax)}</div>
                </div>
              </div>

              <div class={`mt-5 rounded-2xl border p-4 ${adviceTone[advice.level]}`}>
                <div class="font-display font-semibold text-base mb-1">{advice.headline}</div>
                <p class="text-xs sm:text-sm leading-relaxed opacity-90">{advice.detail}</p>
              </div>

              <p class="mt-4 text-xs text-ocean-mid/85 leading-relaxed">
                <span class="font-medium text-ocean-deep">Sun protection: </span>
                {sunAdvice(today.uvIndexMax)}
              </p>
            </div>

            <!-- ACTIONABLE ADVICE -->
            <div class="lg:col-span-3 space-y-5">
              {bundle.risks.length ? (
                <div class="rounded-2xl border border-sunset-pink/40 bg-sunset-pink/10 p-5">
                  <div class="flex items-center gap-2 mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sunset-pink"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                    <span class="font-display font-semibold text-sunset-pink">Risk alerts</span>
                  </div>
                  <ul class="space-y-2">
                    {bundle.risks.map((r) => (
                      <li class="flex gap-2 text-sm text-ocean-deep leading-relaxed">
                        <span class="text-sunset-pink mt-0.5">▸</span>
                        <span>{r.text}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ) : (
                <div class="rounded-2xl border border-palm-green/25 bg-palm-green/10 p-4 flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-palm-green shrink-0"><path d="M20 6 9 17l-5-5"/></svg>
                  <span class="text-sm text-ocean-deep">
                    No particular weather risk to watch right now — proceed with your normal plan.
                  </span>
                </div>
              )}

              <div class="grid sm:grid-cols-2 gap-4">
                {BLOCKS.map((block) => {
                  const items =
                    block.key === 'outfit'
                      ? bundle.outfit
                      : block.key === 'plan'
                        ? bundle.plan
                        : bundle.packing;
                  if (!items.length) return null;
                  return (
                    <div class="card p-5">
                      <div class="flex items-center gap-2 mb-3">
                        <span class="w-8 h-8 rounded-lg bg-sand-warm flex items-center justify-center text-ocean-deep">
                          {block.icon === 'shirt' && (
                            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.4 20.4 17.6 4a2 2 0 0 0-2-1.6L8.4 2.4a2 2 0 0 0-2 1.6L3.6 20.4"/><path d="M3.6 20.4h16.8"/><path d="M8.4 2.4 12 7l3.6-4.6"/></svg>
                          )}
                          {block.icon === 'route' && (
                            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="19" r="3"/><circle cx="18" cy="5" r="3"/><path d="M9 19h4a4 4 0 0 0 0-8h-2a4 4 0 0 1 0-8h4"/></svg>
                          )}
                          {block.icon === 'bag' && (
                            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                          )}
                        </span>
                        <span class="font-display font-semibold text-ocean-deep">{block.title}</span>
                      </div>
                      <ul class="space-y-2">
                        {items.map((item) => (
                          <li class="flex gap-2 text-sm text-ocean-mid leading-relaxed">
                            <span class="text-sunset-orange mt-0.5">▸</span>
                            <span>{item.text}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  );
                })}
              </div>

              {seaLine && (
                <div class="rounded-2xl bg-ocean-deep/5 border border-ocean-deep/10 p-4">
                  <div class="font-display font-semibold text-ocean-deep text-sm mb-1">
                    Seaside conditions
                  </div>
                  <p class="text-sm text-ocean-mid leading-relaxed">{seaLine}</p>
                </div>
              )}
            </div>
          </div>

          <!-- 7 DAY -->
          <div class="card p-6 sm:p-7 mt-6">
            <div class="flex items-center justify-between mb-5">
              <div class="font-display text-lg font-semibold text-ocean-deep">7-day outlook</div>
              <div class="text-[11px] text-ocean-mid">
                Updated {timeFmt.format(new Date(weather.updatedAt))} (GMT+8)
              </div>
            </div>

            <ul class="divide-y divide-sand-warm">
              {weather.daily.map((d, i) => {
                const info = describeWeatherCode(d.weatherCode);
                const chance = rainChance(d);
                return (
                  <li class="py-3 flex items-center gap-3 sm:gap-4">
                    <div class="w-20 sm:w-24 shrink-0">
                      <div class="text-sm font-medium text-ocean-deep">
                        {i === 0 ? 'Today' : dayFmt.format(toDate(d.date)).split(',')[0]}
                      </div>
                      <div class="text-[11px] text-ocean-mid">{dayFmt.format(toDate(d.date))}</div>
                    </div>
                    <div class="shrink-0 w-10 text-center" title={info.label} aria-hidden="true">
                      <svg
                        class="mx-auto"
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#E8772E"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        {info.group === 'clear' && (
                          <>
                            <circle cx="12" cy="12" r="4" />
                            <path d="M12 2v2" />
                            <path d="M12 20v2" />
                            <path d="m4.9 4.9 1.4 1.4" />
                            <path d="m17.7 17.7 1.4 1.4" />
                            <path d="M2 12h2" />
                            <path d="M20 12h2" />
                            <path d="m6.3 17.7-1.4 1.4" />
                            <path d="m19.1 4.9-1.4 1.4" />
                          </>
                        )}
                        {info.group === 'partly' && (
                          <>
                            <path d="M17.5 21H7a5 5 0 1 1 1.6-9.7" />
                            <circle cx="17" cy="7" r="3" />
                          </>
                        )}
                        {(info.group === 'cloudy' || info.group === 'fog') && (
                          <path d="M17.5 19H7a5 5 0 1 1 1.6-9.7A4 4 0 0 1 17.5 19Z" />
                        )}
                        {info.group === 'fog' && (
                          <>
                            <path d="M4 22h16" />
                            <path d="M6 18h12" />
                          </>
                        )}
                        {(info.group === 'drizzle' || info.group === 'rain') && (
                          <>
                            <path d="M17.5 17H7a5 5 0 1 1 1.6-9.7A4 4 0 0 1 17.5 17Z" />
                            <path d="M8 20v2" />
                            <path d="M12 20v3" />
                            <path d="M16 20v2" />
                          </>
                        )}
                        {info.group === 'storm' && (
                          <>
                            <path d="M17.5 17H7a5 5 0 1 1 1.6-9.7A4 4 0 0 1 17.5 17Z" />
                            <path d="m12 19-2 3h4l-2 3" />
                          </>
                        )}
                      </svg>
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="text-xs sm:text-sm text-ocean-deep font-medium truncate">
                        {info.label}
                      </div>
                      <div class="flex items-center gap-2 mt-1.5">
                        <div class="h-1.5 flex-1 rounded-full bg-sand-warm overflow-hidden">
                          <div
                            class="h-full rounded-full bg-ocean-gradient"
                            style={`width:${Math.max(chance, 4)}%`}
                          ></div>
                        </div>
                        <span class="text-[11px] text-ocean-mid w-14 text-right shrink-0">
                          rain {chance}%
                        </span>
                      </div>
                    </div>
                    <div class="shrink-0 text-right">
                      <div class="text-sm font-semibold text-ocean-deep">{Math.round(d.tempMax)}°</div>
                      <div class="text-xs text-ocean-mid">{Math.round(d.tempMin)}°</div>
                    </div>
                  </li>
                );
              })}
            </ul>

            <p class="mt-4 pt-4 border-t border-sand-warm text-[11px] sm:text-xs text-ocean-mid/85 leading-relaxed">
              Temperatures are Celsius and rainfall is millimetres. Rain chance is a probability, not a certainty — at 60% or above bring an umbrella. Forecasts are for planning; in the typhoon season (Jul–Oct) also follow PAGASA alerts.
            </p>
          </div>
        </>
      ) : (
        <div class="card p-6 sm:p-7">
          <div class="font-display text-lg font-semibold text-ocean-deep mb-2">
            Weather forecast temporarily unavailable
          </div>
          <p class="text-sm text-ocean-mid leading-relaxed">
            The live weather could not be loaded; please refresh later. As a general guide: {ENTITY.city} has a tropical marine climate, 24–34°C year-round, with a dry season from November to April and a wet, typhoon-prone rainy season from June to October, and common afternoon thunderstorms.
          </p>
        </div>
      )
    }
  </div>
</section>
