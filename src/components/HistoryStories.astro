---
import { ENTITY } from '../config';

const TIMELINE = [
  {
    era: 'Pre-colonial',
    title: 'A fishing village on the salt shore',
    text: 'Before the Spanish arrived, the Malate area was already a settlement by the bay, where people fished, made salt and traded along the shore. The bay\'s tides and monsoons set the rhythm of daily life.',
  },
  {
    era: '1571 onwards',
    title: 'Churches, forts and a bayfront parish',
    text: 'The Spanish built a parish and defensive works at the south bay; Malate Church (Our Lady of Remedies) became the spiritual centre for sailors and fishers, and the bay became Manila\'s water gateway to the world.',
  },
  {
    era: '1898',
    title: 'Battle of Manila Bay',
    text: 'On 1 May 1898, the Battle of Manila Bay was fought in these very waters, directly changing the Philippines\' colonial fate. Today\'s seawall and promenade lie along that same shoreline of the naval standoff.',
  },
  {
    era: '1900s – 1940s',
    title: 'Cavite Boulevard → Dewey Boulevard',
    text: 'The bayfront avenue was first named after Cavite, then renamed Dewey Boulevard, becoming Manila\'s earliest ceremonial seafront road, with embassies, clubs and residences lining it.',
  },
  {
    era: '1945',
    title: 'Manila devastated, the bayfront too',
    text: 'The Battle of Manila at the end of WWII nearly razed the city, and the bayfront was no exception. Post-war rebuilding shaped the urban fabric along Roxas Boulevard we see today.',
  },
  {
    era: '1948',
    title: 'Renamed Roxas Boulevard',
    text: 'The avenue was renamed Roxas Boulevard in honour of Manuel Roxas, the first president of the Third Philippine Republic — a name it keeps to this day.',
  },
  {
    era: '1970s – 1990s',
    title: 'Reclamation and the Cultural Center complex',
    text: 'From the 1970s, the Cultural Center complex\'s reclamation pushed the shoreline seaward, creating the land of the promenade\'s southern section. Urbanisation also left a long-term shortage of public waterfront space.',
  },
  {
    era: '2000s – today',
    title: 'Baywalk and the rehabilitation program',
    text: 'The Baywalk promenade was built against this backdrop, returning the shoreline to the public; it later became a showcase stretch of the Manila Bay rehabilitation, and Dolomite Beach was completed and opened in the early 2020s.',
  },
];

const LEGENDS = [
  {
    title: 'Why is it called Malate?',
    tag: 'Folk etymology',
    text: 'A popular story holds that Malate comes from the Tagalog word "maalat" (salty), referring to the brackish wells or sea air of the past. This etymology is repeated in gazetteers, but linguists have not settled it — we present it as folklore, not fact.',
  },
  {
    title: 'Our Lady of Remedies',
    tag: 'Religious tradition',
    text: 'Malate Church enshrines Nuestra Señora de los Remedios (Our Lady of Remedies), long regarded as the patron of seafarers and fishers. Local families still pray here before a journey or a voyage — a faith custom, not a historical event.',
  },
  {
    title: 'The sunset as a civic ritual',
    tag: 'Cultural image',
    text: 'The Manila Bay sunset recurs across Philippine literature, painting and photography, seen as a public spectacle that belongs to everyone. Gathering at the promenade and seawall to watch it at dusk is a shared city memory across generations.',
  },
  {
    title: 'Bangka and kalesa',
    tag: 'Living heritage',
    text: 'Traditional outrigger bangka still work the bay, and ornately decorated kalesa carriages appear along the promenade. They are both transport and preserved urban landmarks.',
  },
];
---
<section id="history-stories" class="anchor-offset py-16 sm:py-20 md:py-24 bg-white border-y border-sand-warm">
  <div class="container-wide">
    <div class="max-w-3xl mb-10">
      <span class="chip bg-sunset-purple/10 text-sunset-purple mb-4">History &amp; stories</span>
      <h2 class="section-title">The long story behind {ENTITY.fullName}</h2>
      <p class="section-subtitle mb-0">
        From a pre-colonial fishing village to today's rehabilitation program: eight key moments on the timeline, plus the place-name origins, folk beliefs and cultural imagery passed down among Manileños.
      </p>
    </div>

    <ol class="relative border-l border-sand-warm pl-6 space-y-7 mb-12">
      {
        TIMELINE.map((t) => (
          <li class="relative">
            <span class="absolute -left-[31px] top-1 w-3.5 h-3.5 rounded-full bg-sunset-purple ring-4 ring-white"></span>
            <div class="text-[11px] uppercase tracking-wider text-sunset-purple font-semibold">{t.era}</div>
            <h3 class="font-display text-lg font-semibold text-ocean-deep mt-1">{t.title}</h3>
            <p class="text-sm text-ocean-mid leading-relaxed mt-1.5 max-w-3xl">{t.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="font-display text-xl font-semibold text-ocean-deep mb-5">
      Lore &amp; local colour
    </div>
    <div class="grid sm:grid-cols-2 gap-5">
      {
        LEGENDS.map((l) => (
          <article class="card p-6 flex flex-col">
            <span class="chip bg-sand-warm text-ocean-mid text-[11px] self-start mb-3">{l.tag}</span>
            <h3 class="font-display text-lg font-semibold text-ocean-deep mb-2">{l.title}</h3>
            <p class="text-sm text-ocean-mid leading-relaxed flex-1">{l.text}</p>
          </article>
        ))
      }
    </div>

    <p class="mt-6 text-xs text-ocean-mid/85 leading-relaxed max-w-3xl">
      Note: this section separates a factual timeline from folklore and belief customs. The legend / tradition entries are labelled as such and are not presented as historical fact. For authoritative sources, consult the National Library, the National Museum and the
      <a href={ENTITY.cityGovUrl} target="_blank" rel="noopener noreferrer" class="text-sunset-orange hover:underline mx-1">Manila city government</a>
      public records.
    </p>
  </div>
</section>
