---
import { ENTITY } from '../config';

const HOURS = [
  {
    zone: 'Dolomite Beach',
    hours: '6:00 AM – 6:00 PM',
    note: 'Gated section with bag checks. Closed every Thursday for maintenance and sand rehabilitation.',
    tone: 'bg-sunset-orange/10 text-sunset-orange',
  },
  {
    zone: 'Roxas Blvd Promenade',
    hours: 'Early morning – late evening',
    note: 'Open public space with lighting after dark; short temporary closures possible for events or maintenance.',
    tone: 'bg-palm-green/10 text-palm-green',
  },
  {
    zone: 'Street parking',
    hours: 'Attended during daylight & sunset hours',
    note: 'Bayside slots fill up quickly after 4 PM, especially on weekends.',
    tone: 'bg-ocean-mid/10 text-ocean-mid',
  },
  {
    zone: 'Bay cruise / yacht charters',
    hours: 'By operator schedule',
    note: 'Sunset and dinner cruises depart near the Manila Yacht Club end; book in advance.',
    tone: 'bg-sunset-purple/10 text-sunset-purple',
  },
];

const SUNSET = [
  { period: 'Nov – Jan', time: '5:40 – 5:55 PM', tip: 'The clearest sunset season, with crisp skies — the best viewing conditions of the year' },
  { period: 'Feb – Apr', time: '6:05 – 6:25 PM', tip: 'Hot dry season; clouds often turn fiery at dusk — stay hydrated' },
  { period: 'May – Jul', time: '6:30 – 6:45 PM', tip: 'Start of the rainy season; high chance of dusk light with thunderclouds' },
  { period: 'Aug – Oct', time: '5:55 – 6:35 PM', tip: 'Typhoon season; weather shifts fast — check the day\'s forecast before you go' },
];

const NIGHT = [
  'The promenade and seawall are lit after dark; crowds usually linger until around 21:00',
  'Typical at night: food stalls, drink kiosks, horse-drawn carriage (kalesa) stands and convenience stores',
  'The Dolomite Beach section clears at dusk and is closed at night; night activity centres on the open promenade and seawall',
  'Safety: stay on main, lit paths; avoid unrailed seawall edges and unlit spots',
  'For the return trip, prefer a ride-hailing app or flag a taxi at a proper stand on the main road',
  'Keep valuables in an inside pocket; watch your phone and camera while taking photos',
];

const FREE_THINGS = [
  { title: 'Watch the Manila Bay sunset', desc: 'Free all year, no ticket needed; this page lists sunset times by season under "Best time for the sunset".' },
  { title: 'Walk the 2-km Baywalk promenade', desc: 'A flat seafront walkway with benches, sculptures and shade — good for strollers and wheelchairs.' },
  { title: 'Stroll Rizal Park (Luneta)', desc: 'A city park about 1.8 km away, with the Rizal Monument and the Kilometre Zero marker.' },
  { title: 'Visit Malate Church', desc: 'A 16th-century Baroque church, about 450 m on foot; keep quiet during Mass.' },
  { title: 'Explore Intramuros plazas & walls', desc: 'The walled city\'s plazas and rampart walks are free; indoor museums charge separately.' },
  { title: 'Browse the National Museum cluster', desc: 'The museum cluster sits beside Rizal Park; opening policy and fees follow official notices.' },
];
---
<section id="dolomite" class="anchor-offset py-16 sm:py-20 md:py-24 bg-white border-y border-sand-warm">
  <div class="container-wide">
    <div class="max-w-3xl mb-10">
      <span class="chip bg-sunset-orange/10 text-sunset-orange mb-4">
        Dolomite Beach
      </span>
      <h2 class="section-title">
        Manila Baywalk &amp; Dolomite Beach: entrance fee, opening hours &amp; sunset
      </h2>
      <p class="section-subtitle mb-0">
        The four things visitors search for most, answered at once: is there a fee, what are the hours, when is sunset, and can you go at night. All times follow on-site notices.
      </p>
    </div>

    <!-- FEE + HOURS -->
    <div class="grid lg:grid-cols-5 gap-6">
      <div id="dolomite-fee" class="lg:col-span-2 card p-6 sm:p-7">
        <h3 class="font-display text-xl font-semibold text-ocean-deep mb-1">
          Entrance fee
        </h3>
        <p class="text-xs text-ocean-mid mb-4">Dolomite Beach entrance fee / Baywalk ticket price</p>

        <div class="rounded-2xl bg-palm-green/10 border border-palm-green/25 p-5 mb-5">
          <div class="flex items-baseline gap-2">
            <span class="font-display text-4xl font-semibold text-palm-green">Free</span>
            <span class="text-sm text-ocean-deep font-medium">No entrance fee</span>
          </div>
          <p class="text-sm text-ocean-mid leading-relaxed mt-2">
            Dolomite Beach and the Roxas Blvd promenade are both public spaces, <strong class="text-ocean-deep">free to enter and no booking needed</strong>. The gate only checks for banned single-use plastics.
          </p>
        </div>

        <ul class="space-y-2.5 text-sm text-ocean-mid leading-relaxed">
          <li class="flex gap-2"><span class="text-palm-green mt-0.5">▸</span> Beach section and promenade: free</li>
          <li class="flex gap-2"><span class="text-palm-green mt-0.5">▸</span> Parking: roadside bays about ₱20–50 / hour</li>
          <li class="flex gap-2"><span class="text-palm-green mt-0.5">▸</span> Bay cruise / yacht: charged separately, from ₱1,800 per person</li>
          <li class="flex gap-2"><span class="text-palm-green mt-0.5">▸</span> Swimming is <strong class="text-ocean-deep">not allowed</strong> in this bay section; sand play and viewing are free</li>
        </ul>
      </div>

      <div id="dolomite-hours" class="lg:col-span-3 card p-6 sm:p-7">
        <h3 class="font-display text-xl font-semibold text-ocean-deep mb-1">
          Opening hours &amp; operating days
        </h3>
        <p class="text-xs text-ocean-mid mb-5">Dolomite Beach open hours / Baywalk opening times</p>

        <ul class="divide-y divide-sand-warm">
          {
            HOURS.map((h) => (
              <li class="py-3.5 flex flex-col sm:flex-row sm:items-start gap-2 sm:gap-4">
                <div class="sm:w-52 shrink-0">
                  <div class="font-medium text-ocean-deep text-sm">{h.zone}</div>
                  <span class={`chip ${h.tone} text-[11px] mt-1`}>{h.hours}</span>
                </div>
                <div class="text-sm text-ocean-mid leading-relaxed flex-1">{h.note}</div>
              </li>
            ))
          }
        </ul>

        <p class="mt-4 text-xs text-ocean-mid/85 leading-relaxed">
          Maintenance note: the Dolomite Beach section <strong class="text-ocean-deep">closes every Thursday</strong> for upkeep and sand replenishment; the promenade is usually unaffected. It may close temporarily during official events or typhoon alerts — follow on-site notices and the
          <a href={ENTITY.cityGovUrl} target="_blank" rel="noopener noreferrer" class="text-sunset-orange hover:underline mx-1">Manila city government announcement</a>.
        </p>
      </div>
    </div>

    <!-- SUNSET -->
    <div id="sunset" class="anchor-offset mt-8 card p-6 sm:p-8">
      <h3 class="font-display text-xl font-semibold text-ocean-deep mb-1">
        Best time for the sunset
      </h3>
      <p class="text-sm text-ocean-mid mb-5">
        Manila Bay sunset times shift with the seasons. Generally arrive <strong class="text-ocean-deep">30–40 minutes early</strong> to claim a spot, then stay 20 minutes after for the blue hour.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {
          SUNSET.map((s) => (
            <div class="rounded-xl border border-sand-warm bg-sand-light/60 p-4">
              <div class="text-[11px] uppercase tracking-wider text-ocean-mid">{s.period}</div>
              <div class="font-display text-lg font-semibold text-ocean-deep mt-1">{s.time}</div>
              <div class="text-xs text-ocean-mid leading-relaxed mt-1.5">{s.tip}</div>
            </div>
          ))
        }
      </div>
      <p class="mt-4 text-xs text-ocean-mid/85 leading-relaxed">
        For the precise sunset time today, see the
        <a href="#weather" class="text-sunset-orange hover:underline mx-1">live weather module</a>
        on this page (sunrise / sunset for the Asia/Manila timezone).
      </p>
    </div>

    <!-- NIGHT -->
    <div id="night" class="anchor-offset mt-8 grid lg:grid-cols-5 gap-6">
      <div class="lg:col-span-3 card p-6 sm:p-7">
        <h3 class="font-display text-xl font-semibold text-ocean-deep mb-1">
          Manila Baywalk at night
        </h3>
        <p class="text-xs text-ocean-mid mb-4">Baywalk Manila at night / nightlife &amp; safety</p>
        <ul class="space-y-2.5">
          {
            NIGHT.map((n) => (
              <li class="flex gap-2 text-sm text-ocean-mid leading-relaxed">
                <span class="text-sunset-purple mt-0.5">▸</span>
                <span>{n}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div id="free-things" class="anchor-offset lg:col-span-2 card p-6 sm:p-7">
        <h3 class="font-display text-xl font-semibold text-ocean-deep mb-1">
          Free things to do nearby
        </h3>
        <p class="text-xs text-ocean-mid mb-4">Things to do in Manila for free</p>
        <ol class="space-y-3">
          {
            FREE_THINGS.map((f, i) => (
              <li class="flex gap-2.5">
                <span class="shrink-0 w-5 h-5 rounded-full bg-sand-warm text-ocean-deep text-[11px] font-semibold flex items-center justify-center mt-0.5">
                  {i + 1}
                </span>
                <div>
                  <div class="text-sm font-medium text-ocean-deep">{f.title}</div>
                  <div class="text-xs text-ocean-mid leading-relaxed mt-0.5">{f.desc}</div>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
