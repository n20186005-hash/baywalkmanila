---
import { ENTITY } from '../config';

const SEASONS = [
  {
    name: 'Cool dry season',
    months: 'Nov – Feb',
    temp: '24 – 31 °C (can drop to 21 °C at night)',
    rain: 'Monthly rain 10 – 156 mm, 3 – 12 rainy days, lowest typhoon odds all year',
    sea: 'Small swell, best water clarity of the year, low algae-bloom risk',
    wildlife: 'Peak of overwintering waterbirds; waders, plovers and egrets at the south wetland',
    verdict: 'Best window of the year: clearest sunsets, great for photos, families and long walks',
    tone: 'bg-palm-green/10 text-palm-green',
  },
  {
    name: 'Hot dry season',
    months: 'Mar – May',
    temp: '26 – 35 °C, highest apparent temperature in Apr – May',
    rain: 'Monthly 12 – 148 mm, afternoon thunderstorms pick up',
    sea: 'Warmer water, nutrient buildup, occasional blooms and odour',
    wildlife: 'Mudflat crabs and intertidal invertebrates active; mostly resident birds',
    verdict: 'Only recommend before 8 h and after 17 h; sun protection and water are mandatory',
    tone: 'bg-sunset-orange/10 text-sunset-orange',
  },
  {
    name: 'Southwest monsoon',
    months: 'Jun – Sep',
    temp: '26 – 33 °C, relative humidity often above 80%',
    rain: 'Monthly 268 – 425 mm, 17 – 21 rainy days, main typhoon window',
    sea: 'Large swell, sediment resuspension, turbid water and poor visibility',
    wildlife: 'Migrants gone north; resident birds and swifts; intertidal viewing limited',
    verdict: 'Rain gear essential, avoid high-wind swell days; stay flexible with the forecast',
    tone: 'bg-ocean-mid/10 text-ocean-mid',
  },
  {
    name: 'Transition & typhoon peak',
    months: 'Oct',
    temp: '25 – 32 °C, fast-changing weather',
    rain: 'Monthly about 274 mm, lows and typhoons still frequent',
    sea: 'Unstable seas, water quality swings quickly with rain',
    wildlife: 'First overwintering waterbirds arrive; viewing improves month by month',
    verdict: 'Keep plans flexible; check the latest weather and sea-state alerts before leaving',
    tone: 'bg-sunset-purple/10 text-sunset-purple',
  },
];

const MONTHLY = [
  { m: 'Jan', hi: 30, lo: 22, rain: 17, days: 4, v: 'Best' },
  { m: 'Feb', hi: 31, lo: 22, rain: 10, days: 3, v: 'Best' },
  { m: 'Mar', hi: 33, lo: 23, rain: 12, days: 4, v: 'Good · hot' },
  { m: 'Apr', hi: 34, lo: 24, rain: 27, days: 5, v: 'Dawn / dusk' },
  { m: 'May', hi: 34, lo: 25, rain: 148, days: 12, v: 'Hot, thundery' },
  { m: 'Jun', hi: 33, lo: 25, rain: 268, days: 17, v: 'Wet starts' },
  { m: 'Jul', hi: 32, lo: 24, rain: 419, days: 21, v: 'Typhoon window' },
  { m: 'Aug', hi: 31, lo: 24, rain: 425, days: 21, v: 'Wettest' },
  { m: 'Sep', hi: 31, lo: 24, rain: 369, days: 20, v: 'Persistent rain' },
  { m: 'Oct', hi: 31, lo: 24, rain: 274, days: 17, v: 'Variable' },
  { m: 'Nov', hi: 31, lo: 23, rain: 156, days: 12, v: 'Improves' },
  { m: 'Dec', hi: 30, lo: 22, rain: 84, days: 9, v: 'Good' },
];
---
<section id="seasons" class="anchor-offset py-16 sm:py-20 md:py-24">
  <div class="container-wide">
    <div class="max-w-3xl mb-10">
      <span class="chip bg-palm-green/10 text-palm-green mb-4">Quarterly strategy</span>
      <h2 class="section-title">Quarterly visit strategy for {ENTITY.fullName}</h2>
      <p class="section-subtitle mb-0">
        A combined view of weather, water quality and wildlife — based on the PAGASA 1991–2020 climate normal (30-year average) and publicly available Manila Bay ecological surveys.
      </p>
    </div>

    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm border-collapse min-w-[900px]">
          <thead>
            <tr class="bg-sand-light text-ocean-deep">
              <th class="p-4 font-display font-semibold whitespace-nowrap">Season</th>
              <th class="p-4 font-display font-semibold whitespace-nowrap">Months</th>
              <th class="p-4 font-display font-semibold">Temperature</th>
              <th class="p-4 font-display font-semibold">Rain &amp; storms</th>
              <th class="p-4 font-display font-semibold">Sea &amp; water</th>
              <th class="p-4 font-display font-semibold">Wildlife</th>
              <th class="p-4 font-display font-semibold">Verdict</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-sand-warm">
            {
              SEASONS.map((s) => (
                <tr class="align-top">
                  <td class="p-4 whitespace-nowrap">
                    <span class={`chip ${s.tone} mb-2`}>{s.name}</span>
                  </td>
                  <td class="p-4 whitespace-nowrap font-medium text-ocean-deep">{s.months}</td>
                  <td class="p-4 text-ocean-mid leading-relaxed">{s.temp}</td>
                  <td class="p-4 text-ocean-mid leading-relaxed">{s.rain}</td>
                  <td class="p-4 text-ocean-mid leading-relaxed">{s.sea}</td>
                  <td class="p-4 text-ocean-mid leading-relaxed">{s.wildlife}</td>
                  <td class="p-4 text-ocean-mid leading-relaxed">{s.verdict}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-8">
      <div class="font-display text-lg font-semibold text-ocean-deep mb-4">
        Monthly quick reference (climate normal)
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        {
          MONTHLY.map((x) => (
            <div class="rounded-xl border border-sand-warm bg-white p-3">
              <div class="flex items-baseline justify-between">
                <span class="font-display font-semibold text-ocean-deep">{x.m}</span>
                <span class="text-[11px] text-ocean-mid">{x.v}</span>
              </div>
              <div class="mt-1 text-sm text-ocean-deep font-medium">
                {x.hi}° / {x.lo}°
              </div>
              <div class="text-[11px] text-ocean-mid mt-1">{x.rain} mm · {x.days} rainy days</div>
            </div>
          ))
        }
      </div>
      <p class="mt-4 text-xs text-ocean-mid/85 leading-relaxed">
        The climate normal is a statistical average and individual years can differ greatly; for travel, rely on the
        <a href={ENTITY.pagasaUrl} target="_blank" rel="noopener noreferrer" class="text-sunset-orange hover:underline mx-1">latest PAGASA forecast and alerts</a>.
      </p>
    </div>
  </div>
</section>
