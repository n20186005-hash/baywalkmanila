---
const HALF_DAY = [
  { time: '16:00', title: 'Arrive at Roxas Blvd drop-off', desc: 'Alight at Roxas Blvd and Remedios St, then walk about 3 min into the corridor.' },
  { time: '16:20', title: 'Promenade north section', desc: 'Stroll slowly along the seawall and palm buffer; locate restrooms and water refills first.' },
  { time: '16:50', title: 'Dolomite Beach section', desc: 'Photos, sand play and flat observation; no swimming; note Thursday maintenance closure.' },
  { time: '17:30', title: 'Sunset main slot', desc: 'Claim a seat or sand spot 30 – 40 min early for the sunset and crepuscular rays.' },
  { time: '18:15', title: 'Blue hour', desc: 'About 20 min after sunset is the best balance of sky and city lights.' },
  { time: '18:45', title: 'Snack or dinner', desc: 'Top up at boardwalk stalls, or walk to the Malate dining district for dinner.' },
  { time: '19:30', title: 'Return', desc: 'Return to the drop-off for a ride; roads are congested on weekends, allow 15 min buffer.' },
];

const FULL_DAY = [
  { time: '09:00', title: 'Rizal Park (Luneta)', desc: 'Rizal Park and its museums — Manila\'s civic origin and Kilometre Zero.' },
  { time: '11:30', title: 'Lunch in Malate / Ermita', desc: 'Dine in the old-town district, from street snacks to family restaurants.' },
  { time: '13:00', title: 'Intramuros', desc: 'The walled city: Fort Santiago, San Agustin Church and the rampart walk, about 2 – 3 h.' },
  { time: '15:30', title: 'Coffee & recharge', desc: 'Head back to Roxas Blvd for water and rest, avoiding the midday heat.' },
  { time: '16:30', title: 'Baywalk promenade', desc: 'Enter the corridor and walk south from the north end, about 2 km total.' },
  { time: '17:30', title: 'Sunset at the bay', desc: 'Watch the sunset from the Dolomite Beach or seawall section — the day\'s highlight.' },
  { time: '19:00', title: 'Dinner & night walk', desc: 'After dinner, walk a stretch of the lit corridor; mind your belongings.' },
  { time: '20:30', title: 'Head back', desc: 'Ride-hail or take LRT-1; at night prefer routes with people around.' },
];

---
<section id="itineraries" class="anchor-offset py-16 sm:py-20 md:py-24">
  <div class="container-wide">
    <div class="max-w-3xl mb-10">
      <span class="chip bg-ocean-deep/10 text-ocean-deep mb-4">Sample itineraries</span>
      <h2 class="section-title">Half-day and full-day itineraries around the bay</h2>
      <p class="section-subtitle mb-0">
        A general reference route: the half day leans on the sunset and the corridor; the full day links Rizal Park, Intramuros and Baywalk into one direct history–bay loop.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-6">
      <div class="card p-6 sm:p-7">
        <div class="flex items-center justify-between mb-5">
          <div>
            <div class="font-display text-xl font-semibold text-ocean-deep">Half day</div>
            <div class="text-xs text-ocean-mid mt-0.5">About 3.5 h · sunset-focused</div>
          </div>
          <span class="chip bg-sunset-orange/10 text-sunset-orange">3.5 h</span>
        </div>
        <ol class="relative border-l border-sand-warm pl-5 space-y-5">
          {
            HALF_DAY.map((s) => (
              <li class="relative">
                <span class="absolute -left-[26px] top-1 w-3 h-3 rounded-full bg-sunset-orange ring-4 ring-white"></span>
                <div class="font-mono text-xs text-sunset-orange font-semibold">{s.time}</div>
                <div class="font-medium text-ocean-deep text-sm sm:text-base">{s.title}</div>
                <div class="text-sm text-ocean-mid leading-relaxed mt-0.5">{s.desc}</div>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="card p-6 sm:p-7">
        <div class="flex items-center justify-between mb-5">
          <div>
            <div class="font-display text-xl font-semibold text-ocean-deep">Full day</div>
            <div class="text-xs text-ocean-mid mt-0.5">About 8 h · history + bay combined</div>
          </div>
          <span class="chip bg-ocean-deep/10 text-ocean-deep">8 h</span>
        </div>
        <ol class="relative border-l border-sand-warm pl-5 space-y-5">
          {
            FULL_DAY.map((s) => (
              <li class="relative">
                <span class="absolute -left-[26px] top-1 w-3 h-3 rounded-full bg-ocean-deep ring-4 ring-white"></span>
                <div class="font-mono text-xs text-ocean-deep font-semibold">{s.time}</div>
                <div class="font-medium text-ocean-deep text-sm sm:text-base">{s.title}</div>
                <div class="text-sm text-ocean-mid leading-relaxed mt-0.5">{s.desc}</div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
