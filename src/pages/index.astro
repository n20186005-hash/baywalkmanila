---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, FAQ, NEARBY_EATS, NEARBY_ATTR, TRANSPORT_INFO, GALLERY } from '../config';

const siteUrl: string | undefined = Astro.site?.toString();
const thisPageUrl = siteUrl
  ? new URL(Astro.url.pathname, siteUrl).toString()
  : undefined;

const HERO_IMG = GALLERY.hero;
const HERO_ALT = GALLERY.heroAlt;
const DOLOMITE_IMG = GALLERY.dolomite;
const DOLOMITE_ALT = GALLERY.dolomiteAlt;
const PROMENADE_IMG = GALLERY.promenade;
const PROMENADE_ALT = GALLERY.promenadeAlt;
const SUNSET_IMG = GALLERY.sunset;
const SUNSET_ALT = GALLERY.sunsetAlt;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};

const attractionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: SITE.name,
  alternateName: 'Manila Baywalk Dolomite Beach',
  description: SITE.description,
  image: thisPageUrl ? new URL(HERO_IMG).toString() : HERO_IMG,
  url: thisPageUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: `${SITE.address.district}, ${SITE.address.city}`,
    postalCode: SITE.address.postal,
    addressRegion: SITE.address.region,
    addressCountry: SITE.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: SITE.geo.latitude,
    longitude: SITE.geo.longitude,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Friday', 'Saturday'],
      opens: '06:00',
      closes: '18:00',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: SITE.rating.value,
    ratingCount: SITE.rating.count,
    bestRating: 5,
    worstRating: 1,
  },
  priceRange: '0',
  touristType: ['Families', 'Couples', 'Solo Travelers', 'Photographers'],
  availableLanguage: ['English', 'Filipino'],
};
---
<BaseLayout>
  <slot name="header">
    <header class="sticky top-0 z-40 backdrop-blur-md bg-sand-light/85 border-b border-sand-warm">
      <div class="container-wide flex items-center justify-between h-16">
        <a href="#top" class="flex items-center gap-2.5 group">
          <img src="/logo.svg" alt="Baywalk Manila logo" width="36" height="36" class="w-9 h-9 rounded-lg shadow-sm" />
          <div class="leading-tight">
            <div class="font-display font-semibold text-ocean-deep text-base sm:text-lg group-hover:text-sunset-orange transition-colors">Baywalk Manila</div>
            <div class="text-[10px] sm:text-xs text-ocean-mid uppercase tracking-wider hidden sm:block">Roxas Blvd · Malate</div>
          </div>
        </a>
        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-ocean-mid">
          <a href="#overview" class="hover:text-sunset-orange transition">Overview</a>
          <a href="#tickets" class="hover:text-sunset-orange transition">Tickets</a>
          <a href="#when-to-go" class="hover:text-sunset-orange transition">Best Time</a>
          <a href="#getting-there" class="hover:text-sunset-orange transition">Transport</a>
          <a href="#food" class="hover:text-sunset-orange transition">Food</a>
          <a href="#nearby" class="hover:text-sunset-orange transition">Nearby</a>
          <a href="#faq" class="hover:text-sunset-orange transition">FAQ</a>
        </nav>
        <a href="#map" class="chip bg-sunset-gradient text-white text-xs sm:text-sm shadow-sm hover:opacity-95 transition">
          View on Map
        </a>
      </div>
    </header>
  </slot>

  <!-- HERO -->
  <section id="top" class="relative overflow-hidden">
    <div class="absolute inset-0 bg-ocean-deep/40 z-10"></div>
    <img src={HERO_IMG} alt={HERO_ALT} class="absolute inset-0 w-full h-full object-cover" loading="eager" decoding="async" />
    <div class="relative z-20 container-wide py-24 sm:py-32 md:py-40">
      <div class="max-w-3xl">
        <div class="flex flex-wrap gap-2 mb-5">
          <span class="chip bg-white/15 backdrop-blur-sm text-white border border-white/20">Free Entry</span>
          <span class="chip bg-white/15 backdrop-blur-sm text-white border border-white/20">Iconic Sunset</span>
          <span class="chip bg-white/15 backdrop-blur-sm text-white border border-white/20">Dolomite Beach</span>
          <span class="chip bg-white/15 backdrop-blur-sm text-white border border-white/20">Malate · Manila</span>
        </div>
        <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-semibold text-white leading-[1.1] mb-5 drop-shadow-lg">
          Where the sun paints <span class="text-sunset-orange">Manila Bay</span><br/> in gold every evening.
        </h1>
        <p class="text-sand-light text-base sm:text-lg md:text-xl max-w-2xl leading-relaxed mb-8 drop-shadow">
          A 2-kilometre seaside promenade along Roxas Boulevard, home to the famous Manila Bay sunset, the Dolomite Beach and a century of history from the Battle of Manila Bay to today's urban renewal.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="#overview" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-sunset-gradient text-white font-medium shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition">
            Explore the Baywalk
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="#map" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white/95 backdrop-blur text-ocean-deep font-medium shadow-md hover:bg-white transition">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            Locate on Map
          </a>
        </div>

        <div class="mt-14 grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-2xl">
          <div class="rounded-xl bg-white/10 backdrop-blur border border-white/20 p-4 text-white">
            <div class="text-xs uppercase tracking-wider opacity-80">Rating</div>
            <div class="font-display text-2xl font-semibold mt-1">4.2 / 5</div>
            <div class="text-xs opacity-75 mt-0.5">~6,500 reviews</div>
          </div>
          <div class="rounded-xl bg-white/10 backdrop-blur border border-white/20 p-4 text-white">
            <div class="text-xs uppercase tracking-wider opacity-80">Length</div>
            <div class="font-display text-2xl font-semibold mt-1">2 km</div>
            <div class="text-xs opacity-75 mt-0.5">Promenade strip</div>
          </div>
          <div class="rounded-xl bg-white/10 backdrop-blur border border-white/20 p-4 text-white">
            <div class="text-xs uppercase tracking-wider opacity-80">Entry</div>
            <div class="font-display text-2xl font-semibold mt-1">Free</div>
            <div class="text-xs opacity-75 mt-0.5">No ticket needed</div>
          </div>
          <div class="rounded-xl bg-white/10 backdrop-blur border border-white/20 p-4 text-white">
            <div class="text-xs uppercase tracking-wider opacity-80">Stay</div>
            <div class="font-display text-2xl font-semibold mt-1">1–2 h</div>
            <div class="text-xs opacity-75 mt-0.5">Suggested</div>
          </div>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-b from-transparent to-sand-light z-10 pointer-events-none"></div>
  </section>

  <!-- OVERVIEW / QUICK FACTS -->
  <section id="overview" class="anchor-offset py-16 sm:py-20 md:py-24">
    <div class="container-wide">
      <div class="grid md:grid-cols-2 gap-10 lg:gap-14 items-start">
        <div>
          <h2 class="section-title">A waterfront reclaimed for the city</h2>
          <p class="section-subtitle">
            Stretching from the US Embassy down to the Cultural Center of the Philippines, Baywalk is Manila's most beloved urban promenade. What began as a colonial-era boulevard along the historic Manila Bay is today a public space where families jog, street musicians play and visitors gather to watch one of the most photographed urban sunsets in Southeast Asia.
          </p>
          <p class="text-ocean-mid leading-relaxed mb-6">
            At its heart lies the <strong>Manila Baywalk Dolomite Beach</strong>, a nourished beach of crushed dolomite sand completed in the early 2020s as the centrepiece of the Manila Bay Rehabilitation Program. Paved walkways, palm trees, benches and open-air kiosks run the full length of the strip, blending city life with seaside calm.
          </p>
          <p class="text-ocean-mid leading-relaxed">
            The bay itself carried a decisive role in Philippine history: the <strong>Battle of Manila Bay</strong> of 1898 unfolded on these waters during the Spanish–American War. Walking the promenade today connects you to four centuries of trade, conflict, renewal and the ordinary Manileño's right to a sunset.
          </p>
        </div>
        <div class="grid gap-5">
          <div class="grid sm:grid-cols-2 gap-5">
            <div class="card">
              <img src={DOLOMITE_IMG} alt={DOLOMITE_ALT} loading="lazy" class="w-full h-44 object-cover" />
              <div class="p-4">
                <div class="chip bg-palm-green/10 text-palm-green mb-2">Dolomite Beach</div>
                <div class="font-display text-lg font-semibold text-ocean-deep">Urban beach in the capital</div>
                <div class="text-sm text-ocean-mid mt-1">Sand nourishment sourced from Cebu, part of the multi-year Manila Bay rehabilitation.</div>
              </div>
            </div>
            <div class="card">
              <img src={SUNSET_IMG} alt={SUNSET_ALT} loading="lazy" class="w-full h-44 object-cover" />
              <div class="p-4">
                <div class="chip bg-sunset-orange/10 text-sunset-orange mb-2">Sunset Capital</div>
                <div class="font-display text-lg font-semibold text-ocean-deep">Sky palette at 5pm</div>
                <div class="text-sm text-ocean-mid mt-1">Orange to deep violet every clear evening — the city's quiet showstopper.</div>
              </div>
            </div>
          </div>
          <div class="card p-5 border-sunset-orange/20">
            <div class="flex items-start gap-4">
              <div class="shrink-0 w-12 h-12 rounded-xl bg-sunset-orange/10 text-sunset-orange flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              </div>
              <div>
                <div class="font-display font-semibold text-ocean-deep text-lg">Planning tip</div>
                <div class="text-ocean-mid text-sm leading-relaxed mt-1">
                  Arrive by <strong>4:30 PM</strong> on a weekday to secure a bench or a sand-side spot for sunset. Skip Thursdays if the Dolomite Beach section is your main target — it closes weekly for maintenance.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-14 grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {[
          { label: 'Free entry', icon: 'ticket' },
          { label: 'Dolomite sand', icon: 'sand' },
          { label: 'Sunset views', icon: 'sun' },
          { label: 'Street food', icon: 'food' },
          { label: 'Open daily', icon: 'clock' },
          { label: 'LRT-accessible', icon: 'train' },
        ].map((f) => (
          <div class="rounded-xl border border-sand-warm bg-white px-3 py-4 flex flex-col items-center justify-center text-center">
            <div class="w-9 h-9 rounded-lg bg-sand-warm/50 flex items-center justify-center text-sunset-orange mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                {f.icon === 'ticket' && <>
                  <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/>
                  <path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/>
                </>}
                {f.icon === 'sand' && <>
                  <path d="M2 20a2.4 2.4 0 0 0 2 1 2.4 2.4 0 0 0 2-1 2.4 2.4 0 0 1 2-1 2.4 2.4 0 0 1 2 1 2.4 2.4 0 0 0 2 1 2.4 2.4 0 0 0 2-1 2.4 2.4 0 0 1 2-1 2.4 2.4 0 0 1 2 1 2.4 2.4 0 0 0 2 1 2.4 2.4 0 0 0 2-1"/>
                  <path d="M5.4 14.5a1 1 0 0 1 1.3 0l1.2 1.2a1 1 0 0 0 1.4 0l2.1-2.1a1 1 0 0 1 1.4 0l1.6 1.6a1 1 0 0 0 1.4 0l3-3a1 1 0 0 1 1.6.7v5.1"/><path d="M16 10h.01"/><path d="M12 6v2"/>
                </>}
                {f.icon === 'sun' && <>
                  <circle cx="12" cy="12" r="4"/>
                  <path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
                </>}
                {f.icon === 'food' && <>
                  <path d="M15 11h1a2 2 0 0 1 0 4h-1v-4Z"/><path d="M3 11h4a2 2 0 0 1 0 4H3v-4Z"/><path d="M8 11V4"/><path d="M11 4v22"/><path d="M15 7V2"/>
                </>}
                {f.icon === 'clock' && <>
                  <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
                </>}
                {f.icon === 'train' && <>
                  <rect x="4" y="3" width="16" height="16" rx="2"/>
                  <path d="M4 11h16"/><path d="M12 3v8"/><path d="m8 19-2 3"/><path d="m16 19 2 3"/><path d="M9 7h.01"/><path d="M15 7h.01"/>
                </>}
              </svg>
            </div>
            <div class="text-sm font-medium text-ocean-deep">{f.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TICKETS / FEES -->
  <section id="tickets" class="anchor-offset py-16 sm:py-20 md:py-24 bg-white border-y border-sand-warm">
    <div class="container-wide">
      <div class="grid md:grid-cols-5 gap-10 lg:gap-14 items-start">
        <div class="md:col-span-2">
          <span class="chip bg-palm-green/10 text-palm-green mb-4">Tickets & Fees</span>
          <h2 class="section-title">Entry is free.</h2>
          <p class="section-subtitle">
            Baywalk Manila is a public promenade maintained by the City of Manila and the Department of Environment and Natural Resources. No paid ticket or reservation is required for general access.
          </p>
          <div class="rounded-2xl p-5 bg-sand-light border border-sand-warm">
            <div class="font-display font-semibold text-ocean-deep mb-2">Important house rules</div>
            <ul class="space-y-2 text-sm text-ocean-mid">
              <li class="flex gap-2"><span class="text-sunset-orange mt-0.5">▸</span> Single-use plastics are restricted inside the Dolomite Beach enclosure.</li>
              <li class="flex gap-2"><span class="text-sunset-orange mt-0.5">▸</span> Swimming is not permitted due to ongoing water quality rehabilitation.</li>
              <li class="flex gap-2"><span class="text-sunset-orange mt-0.5">▸</span> Alcohol, smoking and littering are strictly prohibited along the strip.</li>
              <li class="flex gap-2"><span class="text-sunset-orange mt-0.5">▸</span> Security personnel and roving lifeguards are on duty during open hours.</li>
            </ul>
          </div>
        </div>

        <div class="md:col-span-3 grid sm:grid-cols-2 gap-5">
          <div class="card p-6 flex flex-col">
            <div class="flex items-center justify-between mb-4">
              <div class="font-display font-semibold text-ocean-deep text-xl">Dolomite Beach</div>
              <span class="chip bg-palm-green/10 text-palm-green">Free</span>
            </div>
            <p class="text-sm text-ocean-mid leading-relaxed flex-1">
              The crushed-dolomite zone at the core of the promenade. Access regulated by entry/exit gates with bag checks for prohibited single-use plastics.
            </p>
            <div class="mt-4 pt-4 border-t border-sand-warm text-xs text-ocean-mid">
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                <strong class="text-ocean-deep">Thu closed</strong> · 6am – 6pm otherwise
              </div>
            </div>
          </div>

          <div class="card p-6 flex flex-col">
            <div class="flex items-center justify-between mb-4">
              <div class="font-display font-semibold text-ocean-deep text-xl">Roxas Promenade</div>
              <span class="chip bg-palm-green/10 text-palm-green">Free</span>
            </div>
            <p class="text-sm text-ocean-mid leading-relaxed flex-1">
              Open 2-km sidewalk along Roxas Boulevard lined with benches, lamp posts, food vendors and the iconic palm-tree buffer between road and bay.
            </p>
            <div class="mt-4 pt-4 border-t border-sand-warm text-xs text-ocean-mid">
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2v4"/><path d="M12 18v4"/></svg>
                Open-air, no gate
              </div>
            </div>
          </div>

          <div class="card p-6 flex flex-col">
            <div class="flex items-center justify-between mb-4">
              <div class="font-display font-semibold text-ocean-deep text-xl">Parking (street)</div>
              <span class="chip bg-sunset-orange/10 text-sunset-orange">Paid</span>
            </div>
            <p class="text-sm text-ocean-mid leading-relaxed flex-1">
              Designated bayside parking slots managed by city attendants. Expect to queue during sunset hours and weekends.
            </p>
            <div class="mt-4 pt-4 border-t border-sand-warm text-xs text-ocean-mid">
              <div class="flex items-center gap-2">
                <span class="font-semibold text-ocean-deep">PHP 20 – 50</span> / hour depending on area
              </div>
            </div>
          </div>

          <div class="card p-6 flex flex-col">
            <div class="flex items-center justify-between mb-4">
              <div class="font-display font-semibold text-ocean-deep text-xl">Bay Cruise / Yacht</div>
              <span class="chip bg-sunset-purple/10 text-sunset-purple">Separate</span>
            </div>
            <p class="text-sm text-ocean-mid leading-relaxed flex-1">
              Private operators near Manila Yacht Club and the southern end organise 90-minute dinner or sunset cruises on the bay.
            </p>
            <div class="mt-4 pt-4 border-t border-sand-warm text-xs text-ocean-mid">
              <div class="flex items-center gap-2">
                <span class="font-semibold text-ocean-deep">PHP 1,800+</span> per head, varies by package
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHEN TO GO / DURATION / PARKING -->
  <section id="when-to-go" class="anchor-offset py-16 sm:py-20 md:py-24">
    <div class="container-wide">
      <div class="grid lg:grid-cols-3 gap-6 lg:gap-8">
        <div class="card p-6 lg:p-7">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-11 h-11 rounded-xl bg-sunset-orange/10 text-sunset-orange flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
            </div>
            <h3 class="font-display text-xl font-semibold text-ocean-deep">Best time to visit</h3>
          </div>
          <div class="space-y-4 text-sm">
            <div class="flex items-center justify-between py-2 border-b border-sand-warm/80">
              <div class="flex items-center gap-3">
                <span class="w-2 h-2 rounded-full bg-sunset-orange"></span>
                <span class="text-ocean-deep font-medium">Late afternoon · 4:00 – 6:00 PM</span>
              </div>
              <span class="chip bg-sunset-orange/10 text-sunset-orange text-[11px]">Sunset Peak</span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-sand-warm/80">
              <div class="flex items-center gap-3">
                <span class="w-2 h-2 rounded-full bg-palm-green"></span>
                <span class="text-ocean-deep font-medium">Weekday evenings (Mon–Wed)</span>
              </div>
              <span class="chip bg-palm-green/10 text-palm-green text-[11px]">Low Crowds</span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-sand-warm/80">
              <div class="flex items-center gap-3">
                <span class="w-2 h-2 rounded-full bg-ocean-mid"></span>
                <span class="text-ocean-deep font-medium">Dry season · Nov – Apr</span>
              </div>
              <span class="chip bg-ocean-mid/10 text-ocean-mid text-[11px]">Clear Skies</span>
            </div>
            <div class="flex items-center justify-between py-2">
              <div class="flex items-center gap-3">
                <span class="w-2 h-2 rounded-full bg-sunset-pink"></span>
                <span class="text-ocean-deep font-medium">Early morning · 6 – 8 AM</span>
              </div>
              <span class="chip bg-sunset-pink/10 text-sunset-pink text-[11px]">Joggers</span>
            </div>
          </div>
        </div>

        <div class="card p-6 lg:p-7">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-11 h-11 rounded-xl bg-ocean-mid/10 text-ocean-mid flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            </div>
            <h3 class="font-display text-xl font-semibold text-ocean-deep">Suggested stay</h3>
          </div>
          <div class="mb-5">
            <div class="flex items-baseline gap-2 mb-1">
              <span class="font-display text-4xl font-semibold text-ocean-deep">1–2 h</span>
              <span class="text-ocean-mid text-sm">typical visit</span>
            </div>
            <div class="h-2 bg-sand-warm rounded-full overflow-hidden">
              <div class="h-full bg-sunset-gradient w-2/3 rounded-full"></div>
            </div>
          </div>
          <ul class="space-y-3 text-sm text-ocean-mid">
            <li class="flex gap-2.5">
